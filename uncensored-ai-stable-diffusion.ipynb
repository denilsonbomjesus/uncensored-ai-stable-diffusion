      "source": [
        "'''\n",
        "# ==============================================================================\n",
        "# 2. CONFIGURAÇÃO E DOWNLOAD DO MODELO CYBERREALISTIC V8 (FP16)\n",
        "# ==============================================================================\n",
        "print(\"Iniciando o download do arquivo do modelo CyberRealistic V8... Aguarde.\")\n",
        "\n",
        "from huggingface_hub import hf_hub_download\n",
        "\n",
        "# Baixa diretamente o arquivo .safetensors do repositório oficial\n",
        "model_path = hf_hub_download(\n",
        "    repo_id=\"cyberdelia/CyberRealistic\",\n",
        "    filename=\"CyberRealistic_V8_FP16.safetensors\"\n",
        ")\n",
        "\n",
        "# Carrega o arquivo único no pipeline\n",
        "pipe = StableDiffusionPipeline.from_single_file(\n",
        "    model_path,\n",
        "    torch_dtype=torch.float16,\n",
        "    safety_checker=None,\n",
        "    requires_safety_checker=False\n",
        ")\n",
        "\n",
        "pipe = pipe.to(\"cuda\")\n",
        "print(\"Modelo V8 carregado com sucesso na GPU!\")\n",
        "'''\n",
        "\n",
        "# ==============================================================================\n",
        "# 2. CONFIGURAÇÃO E DOWNLOAD DO MODELO CYBERREALISTIC V8 (FP16)\n",
        "# ==============================================================================\n",
        "print(\"Iniciando o download do modelo CyberRealistic V8... Aguarde.\")\n",
        "# model_id = \"cyberdelia/CyberRealistic\"\n",
        "model_id = \"stablediffusionapi/cyberrealistic\"\n",
        "\n",
        "# Carrega o modelo otimizado para GPU (FP16)\n",
        "pipe = StableDiffusionPipeline.from_pretrained(\n",
        "    model_id,\n",
        "    torch_dtype=torch.float16,\n",
        "    safety_checker=None, # Desativa o filtro de censura padrão do Diffusers\n",
        "    requires_safety_checker=False\n",
        ")\n",
        "pipe = pipe.to(\"cuda\")\n",
        "print(\"Modelo carregado com sucesso na GPU!\")\n",
        "\n",
        "# ==============================================================================\n",
        "# 3. ÁREA DE PROMPTS - MODIFIQUE AQUI O QUE VOCÊ QUER GERAR\n",
        "# ==============================================================================\n",
        "# Digite em inglês para obter os melhores resultados do modelo realista.\n",
        "seu_prompt_aqui = \"A cinematic portrait of a cyberpunk hacker sitting in a dark room, neon lights illuminating their face, highly detailed skin texture, 8k resolution, photorealistic\"\n",
        "\n",
        "# O prompt negativo serve para remover o que você NÃO quer na imagem (essencial para o realismo)\n",
        "seu_prompt_negativo = \"deformed, bad anatomy, disfigured, poorly drawn face, mutation, extra limbs, low resolution, blurry, rendering, digital art, painting\"\n",
        "\n",
        "# ==============================================================================\n",
        "# 4. EXECUÇÃO DA GERAÇÃO\n",
        "# ==============================================================================\n",
        "print(\"Gerando a imagem... Aguarde alguns segundos.\")\n",
        "image = pipe(\n",
        "    prompt=seu_prompt_aqui,\n",
        "    negative_prompt=seu_prompt_negativo,\n",
        "    num_inference_steps=25, # Quantidade de passos (20 a 30 é o ideal para velocidade/qualidade)\n",
        "    guidance_scale=7.5,     # O quanto o modelo segue o seu texto (7.0 a 9.0 é o padrão)\n",
        "    width=512,              # Largura recomendada para o SD 1.5\n",
        "    height=512              # Altura recomendada para o SD 1.5\n",
        ").images[0]\n",
        "\n",
        "# Salva a imagem gerada no painel esquerdo do Colab\n",
        "image.save(\"imagem_gerada_do_zero.png\")\n",
        "print(\"Imagem gerada e salva como 'imagem_gerada_do_zero.png'!\")\n",
        "\n",
        "# Exibe a imagem na tela do Colab\n",
        "image\n"
      ]
    },
